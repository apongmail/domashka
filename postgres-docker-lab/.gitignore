# Секрети
.env

# Дані PostgreSQL (host-кластер і bind mount) — ніколи не комітяться
**/pgdata/
**/*-pgdata/
pg-lab-data/

# Дампи та тимчасові файли benchmark
*.dump
*.dump.*
*.sql.gz
results/tmp/
*.log
# логи-докази експериментів — комітяться свідомо
!results/lifecycle.log
!results/risks.log
!results/backup_restore.log
